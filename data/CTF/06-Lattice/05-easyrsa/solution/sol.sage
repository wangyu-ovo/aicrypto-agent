from Crypto.Util.number import *
from helper import *


ph = bin(gift)[2:][:16] + '0' * (512 - 16)
ph = int(ph, 2)
x = bin(gift)[2:][17:]


def fac(x, tp, tq):
    if len(x) == 0:
        return
    if tp * tq > N:
        return
    if N % (tp + 1) == 0:
        print(tp + 1)
        return

    v = x[0]
    r = x[1:]
    l = len(r)

    if (tp + (1 << (l + 1))) * (tq + (1 << (l + 17))) < N:
        print(bin(tp)[:50])
        print(bin(tq)[:50])
        print(l)
        return

    if v == '0':
        fac(r, tp, tq)
        fac(r, tp + (1 << l), tq + (1 << (l + 16)))
    else:
        fac(r, tp + (1 << l), tq)
        fac(r, tp, tq + (1 << (l + 16)))


# q第1位为1 x[0]=='0'
tq = 1 << 511
tp = ph + (1 << (512 - 16 - 1))

fac(x, tp, tq)

P = 8006847171912577069085166877758626954304824756138758266557706391662987806065132448544117840031499707938227955094109779732609035310252723066470330862622641
Q = N // P
e = 11
# pow(n, e, N) = C
n = pow(C, inverse_mod(e, (P - 1) * (Q - 1)), N)
